# Copy to `.env` and adjust. Every value here is fake but structurally valid.
# The real `.env` is gitignored. Environment is validated at startup (Zod).

# Logging level: trace | debug | info | warn | error | fatal
# Default: debug in development, info in production and tests.
LOG_LEVEL=debug

# HTTP API port (apps/api)
API_PORT=3100

# Web dev server port (apps/web)
WEB_PORT=5100
